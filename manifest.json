{
  "manifest_version": 3,
  "name": "Arreglo \u2014 \u79fb\u8fbe\u901a\u81ea\u52a8\u586b\u8868",
  "version": "1.26.0",
  "description": "Auto-fill USCIS forms from Yidatong Immigration CRM",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "https://my.uscis.gov/*",
    "https://xinyuan.angie-li-business.workers.dev/*"
  ],
  "action": {
    "default_title": "Arreglo \u79fb\u8fbe\u901a\u81ea\u52a8\u586b\u8868"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://my.uscis.gov/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "32": "icon32.png"
  }
}